{
  "name": "vue-histogram-slider",
  "description": "Range slider with histogram for vue.js",
  "version": "0.3.8",
  "type": "module",
  "main": "./dist/histogram-slider.umd.min.js",
  "module": "./dist/histogram-slider.mjs",
  "exports": {
    ".": {
      "import": "./dist/histogram-slider.mjs",
      "require": "./dist/histogram-slider.umd.min.js"
    },
    "./histogram-slider.css": "./dist/histogram-slider.css",
    "./dist/histogram-slider.css": "./dist/histogram-slider.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oguzhaninan/vue-histogram-slider.git"
  },
  "keywords": [
    "vue",
    "vuejs",
    "slider",
    "range-slider",
    "histogram",
    "histogram-slider"
  ],
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "d3-array": "^2.3.2",
    "d3-brush": "^1.1.3",
    "d3-scale": "^3.1.0",
    "d3-selection": "^1.4.0",
    "d3-transition": "^1.2.0",
    "jquery": "^3.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "vite": "^5.4.11",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^9.4.3"
  },
  "scripts": {
    "dev": "vite",
    "prepare": "npm run build",
    "build": "vite build && node scripts/rename-lib-css.mjs",
    "preview": "vite preview",
    "prepublishOnly": "npm run lint && npm run build",
    "lint": "eslint src --ext .vue,.js"
  }
}
